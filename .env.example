# =============================================================================
# EcoCircuito — Variáveis de Ambiente (EXEMPLO SEM SEGREDOS REAIS)
# Copie para `.env` localmente. Nunca versione `.env` ou segredos de produção.
# =============================================================================

# Ambiente de execução: development | test | production
ENVIRONMENT=development
APP_NAME=EcoCircuito API
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- PostgreSQL + PostGIS ---
# Em desenvolvimento via Docker Compose, o host do banco dentro da rede é `db`.
# Fora do Compose (rodando uvicorn/alembic direto no host), use `localhost`.
POSTGRES_DB=ecocircuito
POSTGRES_USER=ecocircuito_app
POSTGRES_PASSWORD=dev_only_change_me_app
POSTGRES_MIGRATION_USER=ecocircuito_migrator
POSTGRES_MIGRATION_PASSWORD=dev_only_change_me_migrator

# URL usada pela API em runtime (preferencialmente usuário de menor privilégio)
DATABASE_URL=postgresql+psycopg://ecocircuito_app:dev_only_change_me_app@db:5432/ecocircuito
# URL usada pelo Alembic para executar migrações e habilitar extensão/schemas
MIGRATION_DATABASE_URL=postgresql+psycopg://ecocircuito_migrator:dev_only_change_me_migrator@db:5432/ecocircuito
# URL usada nos testes de integração com PostGIS real
TEST_DATABASE_URL=postgresql+psycopg://ecocircuito_migrator:dev_only_change_me_migrator@localhost:5432/ecocircuito

# --- Segurança HTTP / JWT / CSRF (substituir em produção por segredos CSPRNG >= 32 bytes) ---
JWT_SECRET_KEY=dev-only-unsafe-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=ecocircuito-api
JWT_AUDIENCE=ecocircuito-web
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
CSRF_SECRET_KEY=dev-only-unsafe-csrf-secret-change-in-production-32c

# --- Mesma origem e CORS ---
# Em desenvolvimento, Vite proxy (/api -> api:8000) mantém mesma origem em http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# --- Provedor de Mapa (configurável para avaliação de privacidade e atribuição OSM) ---
TILE_PROVIDER_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_PROVIDER_ATTRIBUTION=© OpenStreetMap contributors

# --- Frontend ---
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://localhost:8000

